{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "node scripts/copy-sample.mjs && node scripts/build-widget.mjs",
    "dev": "next dev",
    "prebuild": "node scripts/copy-sample.mjs && node scripts/build-widget.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "pretest": "node scripts/copy-sample.mjs && node scripts/build-widget.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "mcp:stdio": "node scripts/build-widget.mjs && tsx --conditions=react-server src/mcp/stdio.ts",
    "mcp:exercise": "tsx --conditions=react-server scripts/mcp-exercise.mts",
    "notes:export": "node scripts/export-notes.mjs",
    "dev:notes": "node scripts/copy-sample.mjs && node scripts/build-widget.mjs && OPENSTUDY_LOCAL_NOTES=1 next dev -H 127.0.0.1"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.135.0",
    "@apple/app-store-server-library": "3.1.0",
    "@modelcontextprotocol/server": "^2.3.1",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.117.2",
    "idb-keyval": "^6.3.0",
    "jszip": "^3.10.2",
    "katex": "^0.19.1",
    "lucide-react": "^1.58.0",
    "mcp-handler": "^2.3.0",
    "next": "16.4.2",
    "pdfjs-dist": "^6.4.299",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "stripe": "23.0.0",
    "tesseract.js": "^7.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.4.0",
    "@tailwindcss/turbopack": "^4",
    "@types/katex": "^0.16.8",
    "@types/node": "^22.20.5",
    "@types/pg": "8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "esbuild": "^0.28.2",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "pg": "8.23.1",
    "playwright-core": "^1.64.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.5"
  }
}
