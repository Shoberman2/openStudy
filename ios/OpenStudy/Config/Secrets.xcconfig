// OpenStudy build secrets.
//
// REVENUECAT_API_KEY is a PLACEHOLDER. Spencer: put the real RevenueCat public iOS SDK key (starts
// with "appl_") in OpenStudy/Config/Secrets.local.xcconfig, which git ignores:
//
//     REVENUECAT_API_KEY = appl_xxxxxxxxxxxxxxxxxxxxxxxx
//
// Never commit a real key here. While the placeholder is in place the app talks to StoreKit 2
// directly, so purchases still work in the simulator with OpenStudy.storekit.
REVENUECAT_API_KEY = REVENUECAT_API_KEY_PLACEHOLDER

#include? "Secrets.local.xcconfig"
